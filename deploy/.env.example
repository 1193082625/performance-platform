# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=performance_platform

# Server
APP_ID=demo-web
SERVER_PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
LOG_LEVEL=info

# Console
CONSOLE_PORT=4173

# Demo Web
DEMO_PORT=5173
VITE_MONITOR_ENDPOINT=http://localhost:3000/api/v2/events/batch
VITE_MONITOR_SAMPLE_RATE=1
DEMO_APP_VERSION=0.2.0+compose
DEMO_APP_ENVIRONMENT=development
